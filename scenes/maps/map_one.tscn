[sub_resource type="GDScript" id="GDScript_vuxui"]
script/source = "
extends Node3D

@export var speed: float = 10.0
@export var route_name: String = \"TrafficRoute1\"
@export var stop_distance: float = 1.0

var current_point: int = 0
var route_points: Array[Marker3D] = []

func _ready() -> void:
	var route = get_tree().current_scene.find_child(route_name, true, false)

	if route == null:
		push_error(\"Traffic route not found: \" + route_name)
		set_process(false)
		return

	for child in route.get_children():
		if child is Marker3D:
			route_points.append(child)

	if route_points.is_empty():
		push_error(\"No Marker3D points found in \" + route_name)
		set_process(false)
		return

	global_position = route_points[0].global_position
	current_point = 1 % route_points.size()

func _process(delta: float) -> void:
	if route_points.is_empty():
		return

	var target = route_points[current_point].global_position
	var direction = target - global_position
	direction.y = 0.0

	if direction.length() <= stop_distance:
		current_point = (current_point + 1) % route_points.size()
		return

	global_position += direction.normalized() * speed * delta

	if direction.length_squared() > 0.001:
		look_at(global_position + direction, Vector3.UP)
"

